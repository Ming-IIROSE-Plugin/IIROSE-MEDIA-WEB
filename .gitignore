# 忽略 dist 目录
/dist

# 忽略 node_modules 目录
/node_modules

# 忽略 yarn.lock 文件
/yarn.lock

# BMAD / agent 工具链（生成物，不进仓库）
/.agents
/.claude
/_bmad
/_bmad-output/*
# 「点歌台」UX 规格（DESIGN.md / EXPERIENCE.md）入库；其余 BMAD 产物仍只留本机
!/_bmad-output/initiative-media-desk-redesign/
/_bmad-output/initiative-media-desk-redesign/*
!/_bmad-output/initiative-media-desk-redesign/ux-media-desk/
/_bmad-output/initiative-media-desk-redesign/ux-media-desk/*
!/_bmad-output/initiative-media-desk-redesign/ux-media-desk/DESIGN.md
!/_bmad-output/initiative-media-desk-redesign/ux-media-desk/EXPERIENCE.md
/.opencode
/.bmad-loop

# 敏感资料（测试账号凭据等），绝不入库
/.secrets
/.inject-bundle.js
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/
