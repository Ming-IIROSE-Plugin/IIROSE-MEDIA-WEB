# 忽略 dist 目录
/dist

# 忽略 node_modules 目录
/node_modules

# 忽略 yarn.lock 文件
/yarn.lock

# BMAD / agent 工具链（生成物，不进仓库）
/.agents
/.claude
/_bmad
/_bmad-output/*
# 规格与复盘入库(契约文档,跟着代码走):v7 之后它们在 initiative 的 epic / archive-v6 / backlog 里
!/_bmad-output/initiative-iirose-media-web/
!/_bmad-output/backlog/
# 其余 BMAD 产物仍只留本机:独立构建记录、延期事项、调查记录
/_bmad-output/backlog/*-plan.md
/_bmad-output/initiative-iirose-media-web/deferred-work.md
/_bmad-output/initiative-iirose-media-web/silent-media-control-investigation.md
/_bmad-output/initiative-iirose-media-web/archive-v6/deferred-work-v6-resolved.md
/_bmad-output/initiative-iirose-media-web/ux-media-desk/*
!/_bmad-output/initiative-iirose-media-web/ux-media-desk/DESIGN.md
!/_bmad-output/initiative-iirose-media-web/ux-media-desk/EXPERIENCE.md
/.opencode
/.bmad-loop

# 敏感资料（测试账号凭据等），绝不入库
/.secrets
/.inject-bundle.js
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/

# 体积分析产物（rollup-plugin-visualizer，已不再依赖）
/stats.html

# Python 部署脚本的字节码缓存
__pycache__/
